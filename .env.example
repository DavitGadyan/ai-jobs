# Copy to .env and fill in:  cp .env.example .env

# Supabase -> Project Settings -> API. The secret key never leaves the server; only GETs are sent.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_TABLE=ai_leads

# Public URL of THIS server, ending in /mcp. deploy.sh sets the Lambda one automatically.
MCP_SERVER_URL=http://localhost:8000/mcp

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URIs: http://localhost:8000/auth/callback and <function-url>/auth/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Signs the tokens this server issues and encrypts OAuth state. Keep it stable.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Optional contact shown on /terms and /privacy.
CONTACT_EMAIL=

# Local testing only: skip sign-in entirely. Never on a deployed server.
# AUTH_DISABLED=true
